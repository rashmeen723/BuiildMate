{
    "name": "buildmate-monorepo",
    "private": true,
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "dev": "turbo run dev",
        "build": "turbo run build",
        "lint": "turbo run lint",
        "mobile": "npm run dev --workspace=@buildmate/mobile",
        "api": "npm run dev --workspace=@buildmate/api"
    },
    "devDependencies": {
        "turbo": "^2.0.0"
    }
}